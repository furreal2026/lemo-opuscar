[
 {
  "t0": 95.35,
  "t1": 97.15,
  "text": "Dude. You look terrible."
 },
 {
  "t0": 122.43,
  "t1": 124.37,
  "text": "Cordyceps is a real fungus."
 },
 {
  "t0": 124.43,
  "t1": 126.73,
  "text": "In the forest, one kind infects ants."
 },
 {
  "t0": 128.15,
  "t1": 128.92,
  "text": "It doesn't bite."
 },
 {
  "t0": 128.97,
  "t1": 133.73,
  "text": "It grows: thin threads called hyphae, spreading through the body like roots through soil."
 },
 {
  "t0": 170.55,
  "t1": 172.35,
  "text": "Hey, buddy. It's me."
 },
 {
  "t0": 181.55,
  "t1": 183.69,
  "text": "Dinner Sunday? Mom's making soup."
 },
 {
  "t0": 184.35,
  "t1": 186.15,
  "text": "Yeah\u2026"
 },
 {
  "t0": 206.55,
  "t1": 209.59,
  "text": "In infected ants, the fungus wraps around the muscles."
 },
 {
  "t0": 209.69,
  "t1": 211.67,
  "text": "The brain? Mostly left alone."
 },
 {
  "t0": 267.35,
  "t1": 269.15,
  "text": "Watch it!"
 },
 {
  "t0": 289.35,
  "t1": 291.15,
  "text": "Hey! You okay?"
 },
 {
  "t0": 304.45,
  "t1": 307.4,
  "text": "Then, around noon, the ant climbs a stem, bites a leaf\u2026"
 },
 {
  "t0": 307.45,
  "t1": 310.41,
  "text": "and holds on. It never decided to."
 },
 {
  "t0": 340.25,
  "t1": 343.37,
  "text": "The good news: your body runs at thirty-seven degrees."
 },
 {
  "t0": 343.45,
  "t1": 346.01,
  "text": "Too hot for Cordyceps. In real life."
 },
 {
  "t0": 353.302,
  "t1": 355.722,
  "text": "Officials urge everyone to stay indoors."
 },
 {
  "t0": 402.902,
  "t1": 404.702,
  "text": "Hello? Anyone in there?"
 },
 {
  "t0": 450.702,
  "t1": 452.502,
  "text": "It's Mia! Are you in there?"
 },
 {
  "t0": 484.302,
  "t1": 486.102,
  "text": "Stay back!"
 },
 {
  "t0": 503.502,
  "t1": 505.302,
  "text": "Don't!"
 },
 {
  "t0": 512.702,
  "t1": 514.502,
  "text": "Is\u2026 is that you?"
 },
 {
  "t0": 566.102,
  "t1": 567.902,
  "text": "Last warning."
 },
 {
  "t0": 628.102,
  "t1": 632.342,
  "text": "Perhaps the worst part of becoming a zombie isn't losing your humanity."
 },
 {
  "t0": 632.602,
  "t1": 635.222,
  "text": "It's being forced to watch yourself lose it."
 }
]