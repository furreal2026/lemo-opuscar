   "text": "that's nine meters. A two-story roof. From standing!",
   "line": "l14"
  },
  {
   "t0": 71.03,
   "t1": 72.83,
   "text": "Your neighbors have questions.",
   "line": "l15"
  },
  {
   "t0": 74.45,
   "t1": 76.2,
   "text": "Power number four: super hearing!",
